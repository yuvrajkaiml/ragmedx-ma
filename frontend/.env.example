# RAGMedX-MA frontend — public environment variables (Vite)
#
# Only VITE_-prefixed variables are exposed to the browser. These values are
# SHIPPED TO THE CLIENT BUNDLE at build time — NEVER put secrets, API keys, or
# tokens here. Backend secrets stay server-side (see backend/.env.example).

# Optional. Overrides the WebSocket host for the live query stream.
# Only needed in production when the reverse proxy does NOT upgrade WebSocket
# connections on /api. In dev, the Vite proxy (ws: true) handles the upgrade and
# the client auto-targets the dev origin, so leave this empty.
# Example: VITE_BACKEND_WS_HOST=api.example.com
VITE_BACKEND_WS_HOST=
