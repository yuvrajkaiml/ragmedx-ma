# Environment Variables Template
# `true` enables SQLAlchemy's verbose SQL echo; keep this `false` for normal
# development and test runs.
DEBUG=false

# ---------------------------------------------------------------------------
# Authentication email (required when AUTH_REQUIRE_EMAIL_VERIFICATION=true)
# ---------------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# LLM Runtime Mode
# ---------------------------------------------------------------------------
# Controls whether the local GPU model is used for inference.
#
#   mock  (default) — deterministic stub responses; no GPU or model weights
#                     required. Safe for local development and CI.
#   real            — loads the configured model via bitsandbytes 4-bit NF4
#                     quantization. Requires: a built FAISS index (see
#                     RAGMEDX_FAISS_INDEX_DIR), a CUDA-capable GPU, and a
#                     working bitsandbytes installation. The service will
#                     refuse to start if the index or GPU is unavailable.
#
RAGMEDX_LLM_MODE=mock

# HuggingFace model ID or local path used when RAGMEDX_LLM_MODE=real.
# Must be a Qwen3/Qwen2.5/Llama-3.1-class causal LM supported by the
# bitsandbytes NF4 quantization path in LocalLLMWrapper.
RAGMEDX_LLM_MODEL_NAME=Qwen/Qwen3-8B

# ---------------------------------------------------------------------------
# FAISS Index Location
# ---------------------------------------------------------------------------
# Directory that must contain index.faiss and chunks.pkl.
# Relative paths are resolved from the backend/ directory.
# Build the index with: python -m scripts.build_index
#
RAGMEDX_FAISS_INDEX_DIR=data/faiss_index

# ---------------------------------------------------------------------------
# Chunking (used by MedicalChunker.from_settings() and the build script)
# ---------------------------------------------------------------------------
# Maximum characters per chunk. BioASQ snippets average ~215 chars so most
# will produce exactly one chunk; only longer passages are split.
RETRIEVAL_CHUNK_SIZE=1000

# Overlap characters carried over from the previous chunk when splitting.
RETRIEVAL_CHUNK_OVERLAP=150

# Chunks shorter than this are discarded. Keep low (default 50) so short
# BioASQ snippets are retained.
RETRIEVAL_CHUNK_MIN_CHARS=50
